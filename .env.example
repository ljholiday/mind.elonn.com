# --- App --------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
APP_URL=https://mind.elonn.local

# --- Model provider ---------------------------------------------------
MODEL_TIMEOUT_SECONDS=20
MODEL_OUTPUT_TOKENS=600
# Shared provider endpoints/credentials, used by whichever tier picks that provider.
OPENAI_RESPONSES_URL=
OPENAI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# --- Models: three tiers --------------------------------------------------
# Reasoning runs on one tier. Only "frontier" is enabled by default; a Call may
# request "cheap" or "in_house" via content.tier once an operator enables them.
# An unset/blank tier or a disabled/unconfigured one falls back to frontier;
# if frontier is unconfigured, mind.reason returns mind.model_unavailable.
# Prices are USD per 1,000,000 tokens; leave blank to record tokens with cost_usd null.
#
# frontier -- heavy lifting (GPT-5.6 Sol)
MODEL_FRONTIER_ENABLED=true
MODEL_FRONTIER_PROVIDER=openai
MODEL_FRONTIER_NAME=gpt-5.6-sol
MODEL_FRONTIER_INPUT_PRICE_PER_MILLION=4.00
MODEL_FRONTIER_CACHED_INPUT_PRICE_PER_MILLION=0.40
MODEL_FRONTIER_OUTPUT_PRICE_PER_MILLION=20.00
#
# cheap -- mundane reasoning (GPT-5.6 Luna)
MODEL_CHEAP_ENABLED=false
MODEL_CHEAP_PROVIDER=openai
MODEL_CHEAP_NAME=gpt-5.6-luna
MODEL_CHEAP_INPUT_PRICE_PER_MILLION=0.20
MODEL_CHEAP_CACHED_INPUT_PRICE_PER_MILLION=0.02
MODEL_CHEAP_OUTPUT_PRICE_PER_MILLION=1.20
#
# in_house -- self-hosted model via Ollama; no per-token cost
MODEL_IN_HOUSE_ENABLED=false
MODEL_IN_HOUSE_PROVIDER=ollama
MODEL_IN_HOUSE_NAME=
MODEL_IN_HOUSE_INPUT_PRICE_PER_MILLION=
MODEL_IN_HOUSE_CACHED_INPUT_PRICE_PER_MILLION=
MODEL_IN_HOUSE_OUTPUT_PRICE_PER_MILLION=

# --- AI usage accounting ---------------------------------------------
# One append-only JSON line per reasoning provider call, mirrored by
# admin.elonn's Operations Center through GET /metrics/ai-usage. Per-model
# rates live with each tier above (MODEL_<TIER>_*_PRICE_PER_MILLION).
MIND_AI_USAGE_PATH=storage/ai-usage/mind-ai-usage.jsonl
# Newest N events kept on disk; older ones are pruned. 0 disables pruning.
MIND_AI_USAGE_MAX_RECORDS=5000

# --- Service authentication ------------------------------------------
# Optional Operations Center access.
ELONN_ADMIN_MIND_TOKEN=

# Conductor signed-request verification.
# Derived automatically from APP_ENV (conductor.elonn.local / conductor.elonn.com) -- only set this
# if Conductor's real address ever needs to be pinned to something else.
# CONDUCTOR_SERVICE_KEYS_URL=
