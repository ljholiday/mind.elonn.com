# --- App --------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
APP_URL=https://mind.elonn.local

# --- Model provider -----------------------------------------------------
# MODEL_PROVIDER supports openai. Leave blank to fail closed (mind.reason
# returns mind.model_unavailable instead of a fake result).
MODEL_PROVIDER=
MODEL_NAME=gpt-5.6
MODEL_TIMEOUT_SECONDS=20
MODEL_OUTPUT_TOKENS=600
OPENAI_RESPONSES_URL=
OPENAI_API_KEY=

# --- Service authentication ------------------------------------------
# Optional Operations Center access.
ELONN_ADMIN_MIND_TOKEN=

# Conductor signed-request verification.
# Derived automatically from APP_ENV (conductor.elonn.local / conductor.elonn.com) -- only set this
# if Conductor's real address ever needs to be pinned to something else.
# CONDUCTOR_SERVICE_KEYS_URL=
