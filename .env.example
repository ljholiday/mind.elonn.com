# --- App --------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
APP_URL=https://mind.elonn.local

# --- Model provider -----------------------------------------------------
# MODEL_PROVIDER supports openai. Leave blank to fail closed (mind.reason
# returns mind.model_unavailable instead of a fake result).
MODEL_PROVIDER=
MODEL_NAME=gpt-5.6
MODEL_TIMEOUT_SECONDS=20
MODEL_OUTPUT_TOKENS=600
OPENAI_RESPONSES_URL=
OPENAI_API_KEY=

# --- AI usage accounting ---------------------------------------------
# One append-only JSON line per reasoning provider call, mirrored by
# admin.elonn's Operations Center through GET /metrics/ai-usage.
MIND_AI_USAGE_PATH=storage/ai-usage/mind-ai-usage.jsonl
# Newest N events kept on disk; older ones are pruned. 0 disables pruning.
MIND_AI_USAGE_MAX_RECORDS=5000
# Model prices in USD per 1,000,000 tokens. Without this, events still record
# token counts but cost_usd is null. One JSON object so dotted model ids never
# become env keys.
# Example: {"openai":{"gpt-5.6":{"input_per_million":1.25,"output_per_million":10.0}}}
MODEL_PRICING_JSON=

# --- Service authentication ------------------------------------------
# Optional Operations Center access.
ELONN_ADMIN_MIND_TOKEN=

# Conductor signed-request verification.
# Derived automatically from APP_ENV (conductor.elonn.local / conductor.elonn.com) -- only set this
# if Conductor's real address ever needs to be pinned to something else.
# CONDUCTOR_SERVICE_KEYS_URL=
